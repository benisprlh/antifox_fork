# Docker deployment settings (copy to .env)
# The application image is built from this fork by Docker Compose.
POSTGRES_USER=antifox
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=antifox

# LLM (leave blank to configure provider profiles in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
# anthropic | openai | openai-responses | grok | deepseek
ANTIFOX_LLM_PROVIDER=
ANTIFOX_LLM_MODEL=
ANTIFOX_LLM_BASE_URL=
ANTIFOX_LLM_PROXY=
